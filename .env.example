# Copy to .env and fill in your OpenAI API key and optional model
# OPENAI_API_KEY=your_api_key_here

# Model for price-based AI alerts (default: gpt-5-nano)
OPENAI_MODEL=gpt-5-nano

# Model for SEC filing analysis (default: gpt-4.1)
SEC_OPENAI_MODEL=gpt-4.1

OPENAI_API_BASE=https://api.openai.com/v1

# Model token budget (default used by helper: 650)
OPENAI_MAX_COMPLETION_TOKENS=650

# Use the new Responses API for extra reasoning controls (set to 1 to enable)
OPENAI_USE_RESPONSES=1

# Optional: per-run minimum sample override (default/interval caps exist in code)
OPENAI_MIN_SAMPLES=30

# Optional: prompt tuning hooks used in the helper (strings; defaults used if unset)
OPENAI_REASONING_EFFORT=minimal
OPENAI_TEXT_VERBOSITY=low

# Optional: delay (seconds) between AI calls when ticker.sh runs multiple symbols
ALERT_DELAY=0

# Number of helper calls to run in parallel when multiple symbols request AI alerts.
# Increase to speed up parallel AI lookups; decrease to limit concurrent requests.
# Default used by the script when unspecified: THREADS=7
THREADS=7

# Default alert timeframe used when -a is provided without a timeframe
# Examples: 1m,5m,15m,1h,1d,1w,1y
ALERT_DEFAULT=1d

# Whether to remove per-run run artifacts by default (true/false)
# Set to false to preserve run artifacts for debugging.
CLEANUP=true

# Show only signals without detailed reasoning (0=show full rationale, 1=compact mode)
# Can also be toggled with the -c or --compact flag at runtime
COMPACT_MODE=0

# SEC filing review settings (for -f flag)
# Comma-separated list of SEC filing types to monitor (default: 8-K,10-Q,10-K)
SEC_ONLY_FORMS=8-K,10-Q,10-K

# Maximum number of recent filings to review per symbol (default: 3)
SEC_MAX_FILINGS=3

# User-Agent header for SEC EDGAR requests (required by SEC)
# Format: "Application Name (contact: email@example.com)"
EDGAR_USER_AGENT="Stock Alert Monitor (contact: you@example.com)"

# Optional: Webhook URL for SEC filing alerts
# If set, alerts will be sent to this URL as JSON payloads
# WEBHOOK_URL=https://your-webhook-endpoint.com/alerts

