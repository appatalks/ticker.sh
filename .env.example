# Copy to .env and fill in your OpenAI API key and optional model
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_API_BASE=https://api.openai.com/v1
# Maximum tokens to allow for the model's completion (default used by helper: 800)
OPENAI_MAX_COMPLETION_TOKENS=800
# Opt-in to the Responses API (set to 1 to enable). When enabled, the helper may send
# `reasoning` and `text` tuning fields that are only accepted by the Responses API.
OPENAI_USE_RESPONSES=0
