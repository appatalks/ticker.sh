# Copy to .env and fill in your OpenAI API key and optional model
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_API_BASE=https://api.openai.com/v1
# Maximum tokens to allow for the model's completion (default used by helper: 800)
OPENAI_MAX_COMPLETION_TOKENS=800
# For GPT-5 reasoning and verbosity tuning, set this to 1.
OPENAI_USE_RESPONSES=1
