# Copy to .env and fill in your OpenAI API key and optional model
# OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Model token budget (default used by helper: 650)
OPENAI_MAX_COMPLETION_TOKENS=650

# Use the new Responses API for extra reasoning controls (set to 1 to enable)
OPENAI_USE_RESPONSES=1

# Optional: per-run minimum sample override (default/interval caps exist in code)
OPENAI_MIN_SAMPLES=30

# Optional: prompt tuning hooks used in the helper (strings; defaults used if unset)
OPENAI_REASONING_EFFORT=minimal
OPENAI_TEXT_VERBOSITY=low

# Optional: delay (seconds) between AI calls when ticker.sh runs multiple symbols
ALERT_DELAY=0

# Number of helper calls to run in parallel when multiple symbols request AI alerts.
# Increase to speed up parallel AI lookups; decrease to limit concurrent requests.
# Default used by the script when unspecified: THREADS=7
THREADS=7

# Default alert timeframe used when -a is provided without a timeframe
# Examples: 1m,5m,15m,1h,1d,1w,1y
ALERT_DEFAULT=1d

# Whether to remove per-run run artifacts by default (true/false)
# Set to false to preserve run artifacts for debugging.
CLEANUP=true

