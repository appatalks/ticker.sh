# Copy to .env and fill in your OpenAI API key and optional model
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Model token budget (default used by helper: 800)
OPENAI_MAX_COMPLETION_TOKENS=800

# Use the new Responses API for extra reasoning controls (set to 1 to enable)
OPENAI_USE_RESPONSES=1

# Optional: per-run minimum sample override (default/interval caps exist in code)
OPENAI_MIN_SAMPLES=30

# Optional: prompt tuning hooks used in the helper (strings; defaults used if unset)
OPENAI_REASONING_EFFORT=minimal
OPENAI_TEXT_VERBOSITY=low

# Optional: delay (seconds) between AI calls when ticker.sh runs multiple symbols
ALERT_DELAY=4